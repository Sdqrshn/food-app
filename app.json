{
  "expo": {
    "name": "Food Ranker",
    "slug": "food-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sdqrshn.foodranker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
